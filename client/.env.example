# ---- CentralHub client environment ----
# Copy to client/.env and fill in real values. Never commit .env.

# Clerk publishable key (Clerk Dashboard → API Keys). Same value as the
# server's CLERK_PUBLISHABLE_KEY.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_xxx"

# Base URL for the API.
# Local dev: leave blank to use the Vite proxy (/api → local backend).
# Production: the deployed Railway backend origin, e.g. https://api.example.com
VITE_API_BASE_URL=""

# Optional (local dev only): backend port the Vite proxy targets. Defaults to
# 3001. Set this if your server runs on a different port.
# API_PROXY_PORT="3001"
