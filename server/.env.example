# ---- CentralHub server environment ----
# Copy to server/.env and fill in real values. Never commit .env.

# PostgreSQL connection string (Railway Postgres → "Connect" → connection URL).
DATABASE_URL="postgresql://user:password@host:port/database"

# Clerk API keys (Clerk Dashboard → API Keys).
CLERK_SECRET_KEY="sk_test_xxx"
CLERK_PUBLISHABLE_KEY="pk_test_xxx"

# Your Clerk user ID for the single admin (Clerk Dashboard → Users → your profile).
# Optional: only used by the seed script to create the admin User record.
ADMIN_CLERK_USER_ID="user_xxx"

# Optional: the Clerk Organization ID for "The Fay San Jose".
# If set, only membership in THIS org grants access (disambiguates multi-org users).
CLERK_ORG_ID="org_xxx"

# The deployed frontend origin, used for CORS (no trailing slash).
# Local dev: http://localhost:5173
FRONTEND_URL="http://localhost:5173"

# Port the API listens on (defaults to 3001).
PORT="3001"
